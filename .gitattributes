# Shell scripts must always keep LF line endings — they run on Arch Linux,
# and a CRLF shebang line breaks the interpreter there. Don't let Windows
# checkouts (core.autocrlf) silently corrupt them.
*.sh text eol=lf
*.md text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
LICENSE text eol=lf

# Branding pack: config/scripts stay LF (some get sourced/executed on
# target Linux systems), images are explicitly binary so nothing ever
# tries to line-ending-convert them.
*.py text eol=lf
*.txt text eol=lf
*.script text eol=lf
*.plymouth text eol=lf
*.cfg text eol=lf
*.conf text eol=lf
*.template text eol=lf
*.zshrc text eol=lf
*.example text eol=lf
*.local text eol=lf
*.ovpn text eol=lf
*.png binary
